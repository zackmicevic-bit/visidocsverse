{
  "appName": "VisiDocsVerse",
  "version": "1.0.0",
  "entry": "index.html",
  "dcpSetupMaker": {
    "scanDirectories": [
      "src/css",
      "src/js",
      "src/js/vendor",
      "src/assets",
      "src/assets/overlays",
      "src/assets/backdrops",
      "src/assets/samples",
      "tools"
    ],
    "includeExtensions": [
      ".html",
      ".css",
      ".js",
      ".mjs",
      ".json",
      ".png",
      ".jpg",
      ".md",
      ".txt"
    ],
    "exclude": [
      "node_modules",
      ".git",
      "dist"
    ],
    "outputDir": "dist",
    "installerName": "VisiDocsVerse-setup"
  },
  "runtime": {
    "offline": true,
    "protocols": [
      "http (local static server recommended)"
    ],
    "notes": "ES modules + fetch() require http(s) or the packaged shell — plain file:// double-click is blocked by browser CORS, same as the desktop frontend."
  }
}
